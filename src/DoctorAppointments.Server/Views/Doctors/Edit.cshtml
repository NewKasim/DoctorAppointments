@model DoctorAppointments.Server.ViewModels.DoctorFormViewModel

@{
    ViewData["Title"] = "Edit Doctor";
}

<h1>Edit Doctor</h1>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Edit"
              asp-route-id="@ViewData["DoctorId"]"
              method="post">
            <partial name="_DoctorForm" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}