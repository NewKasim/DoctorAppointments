@model DoctorAppointments.Core.Entities.Doctor

@{
    ViewData["Title"] = "Add Appointment Slot";
}

<h1>Add Appointment Slot</h1>
<p>@Model.FullName</p>

<form asp-action="AddSlot" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label for="startsAtIst" class="form-label">
            Start date and time (IST)
        </label>
        <input id="startsAtIst"
               name="startsAtIst"
               type="datetime-local"
               step="1800"
               required
               class="form-control"
               style="max-width: 22rem;" />
        <div class="form-text">
            Each slot is 30 minutes. Choose a time like 10:00 or 10:30.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Slot</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Doctors</a>
</form>