@model IEnumerable<DoctorAppointments.Core.Entities.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Doctors</h1>

    <a asp-action="Create" class="btn btn-primary">
        Add Doctor
    </a>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Not yet any doctor added. Please click on the "Add Doctor" button to create a new doctor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Qualification</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>@doctor.FullName</td>
                        <td>@doctor.Department.Name</td>
                        <td>@doctor.Qualification</td>
                        <td>@doctor.ExperienceYears years</td>
                        <td>₹@doctor.ConsultationFee.ToString("N2")</td>
                         <td>
                            <a asp-action="AddSlot"
                               asp-route-id="@doctor.Id"
                               class="btn btn-sm btn-outline-primary">
                                Add Slot
                            </a>

                        <td>
                            <span class="badge @(doctor.IsActive ? "bg-success" : "bg-secondary")">
                                @(doctor.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@doctor.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}