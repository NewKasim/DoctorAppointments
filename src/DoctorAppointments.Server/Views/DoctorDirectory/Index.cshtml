@model IEnumerable<DoctorAppointments.Core.Entities.Doctor>

@{
    ViewData["Title"] = "Find a Doctor";
}

<h1>Find a Doctor</h1>

<form asp-controller="DoctorDirectory" asp-action="Index" method="get"
      class="row g-2 align-items-end mb-4">
    <div class="col-sm-5">
        <label for="departmentId" class="form-label">Department</label>
        @Html.DropDownList(
            "departmentId",
            (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Departments,
            "All departments",
            new { @class = "form-select" })
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No doctors are available for this selection.</p>
}
else
{
    <div class="row g-3">
        @foreach (var doctor in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">@doctor.FullName</h2>
                        <p class="text-muted">@doctor.Department.Name</p>
                        <p>@doctor.Qualification</p>
                        <p>@doctor.ExperienceYears years of experience</p>
                        <p class="mb-0">
                            Consultation fee: ₹@(doctor.ConsultationFee.ToString("N2"))
                        </p>
                    </div>
                </article>
            </div>
        }
    </div>
}